.json\\\"\\n\\n# กำหนดรายการอุปกรณ์มาตรฐานทั้งหมด (6 ชิ้น)\\nFULL_TOOLS = {\\n\\t\\\"Wrench_10\\\": 1,\\n\\t\\\"Wrench_11\\\": 1,\\n\\t\\\"Wrench_12\\\": 1,\\n\\t\\\"Wrench_14\\\": 1,\\n\\t\\\"Wrench_15\\\": 1,\\n\\t\\\"Wrench_17\\\": 1\\n}\\n\\nSTABLE = 3         # นิ่ง 3 เฟรม (~0.8-1 วินาที) ยืนยันเหตุการณ์ทันที\\nMEM_SEC = 15.0     # จำใบหน้าล่าสุดไว้ 15 วินาที\\nWORK_START = 8     # เวลาเริ่มงาน (08:00 น.)\\nWORK_END = 17      # เวลาเลิกงาน (17:00 น.)\\n\\ndef u(s):\\n\\treturn s if isinstance(s, unicode) else unicode(str(s), \\\"utf-8\\\", \\\"ignore\\\")\\n\\ndef push(msg, st):\\n\\treq = urllib2.Request(\\n\\t\\t\\\"https://api.line.me/v2/bot/message/push\\\",\\n\\t\\tdata=json.dumps({\\\"to\\\": UID, \\\"messages\\\": [{\\\"type\\\": \\\"text\\\", \\\"text\\\": u(msg)}]}),\\n\\t\\theaders={\\n\\t\\t\\t\\\"Content-Type\\\": \\\"application/json\\\",\\n\\t\\t\\t\\\"Authorization\\\": \\\"Bearer \\\" + TOKEN,\\n\\t\\t\\t\\\"User-Agent\\\": \\\"Mozilla/5.0\\\"\\n\\t\\t}\\n\\t)\\n\\ttry:\\n\\t\\ttry:\\n\\t\\t\\tr = urllib2.urlopen(req, timeout=4, context=_ssl)\\n\\t\\texcept TypeError:\\n\\t\\t\\tr = urllib2.urlopen(req, timeout=4)\\n\\t\\tst[\\\"line_status\\\"] = \\\"OK (%s)\\\" % r.getcode()\\n\\texcept Exception as e:\\n\\t\\tst[\\\"line_status\\\"] = \\\"Err: %s\\\" % e\\n\\nnow = time.time()\\nnow_dt = datetime.now()\\ntoday_str = now_dt.strftime(\\\"%Y-%m-%d\\\")\\nis_work_time = (WORK_START <= now_dt.hour < WORK_END)\\n\\ntm = None\\nif os.path.exists(STATE_FILE):\\n\\ttry:\\n\\t\\twith open(STATE_FILE, \\\"r\\\") as f:\\n\\t\\t\\ttm = json.load(f)\\n\\texcept Exception:\\n\\t\\ttm = None\\n\\nif not tm or tm.get(\\\"v\\\") != 10 or (now - tm.get(\\\"last_seen\\\", 0) > 30.0):\\n\\ttm = {\\n\\t\\t\\\"v\\\": 10, \\\"init\\\": False, \\\"ok\\\": {}, \\\"cand\\\": {}, \\\"n\\\": 0,\\n\\t\\t\\\"who\\\": \\\"\\\", \\\"st\\\": \\\"none\\\", \\\"known_ts\\\": 0.0, \\\"ts\\\": 0.0,\\n\\t\\t\\\"last_seen\\\": now, \\\"off_report_date\\\": \\\"\\\", \\\"line_status\\\": \\\"Starting...\\\"\\n\\t}\\n\\ntm[\\\"last_seen\\\"] = now\\n\\n# 1. ตรวจจับใบหน้า (ล็อกคนในระบบไว้ไม่ให้มุมก้มหน้าเขียนทับ)\\nfr = payload.get(\\\"FaceRec\\\", {})\\nknown, unk = None, False\\nif isinstance(fr, dict):\\n\\tfor f in fr.get(\\\"face_array\\\", []):\\n\\t\\tnm = f.get(\\\"name\\\", \\\"\\\").strip()\\n\\t\\tif nm:\\n\\t\\t\\tif nm.lower() == \\\"unknown\\\":\\n\\t\\t\\t\\tunk = True\\n\\t\\t\\telse:\\n\\t\\t\\t\\tknown = nm\\n\\t\\t\\t\\tbreak\\n\\tif not known and int(fr.get(\\\"unknown_count\\\", 0)) > 0:\\n\\t\\tunk = True\\n\\nif known:\\n\\ttm.update({\\\"who\\\": known, \\\"st\\\": \\\"known\\\", \\\"known_ts\\\": now, \\\"ts\\\": now})\\nelif unk and (now - tm.get(\\\"known_ts\\\", 0) > 8.0):\\n\\ttm.update({\\\"who\\\": \\\"Unknown\\\", \\\"st\\\": \\\"unknown\\\", \\\"ts\\\": now})\\n\\n# 2. อ่านค่าอุปกรณ์ปัจจุบันบนโต๊ะจาก DeepDetect\\ndd = payload.get(\\\"DeepDetect\\\", {}).get(\\\"counts\\\", {})\\nall_keys = sorted(set(FULL_TOOLS.keys()) | set(dd.keys()) | set(tm[\\\"ok\\\"].keys()))\\ncur = {k: int(dd.get(k, 0)) for k in all_keys}\\n\\ntm[\\\"n\\\"] = tm[\\\"n\\\"] + 1 if cur == tm[\\\"cand\\\"] else 1\\ntm[\\\"cand\\\"] = cur.copy()\\n\\n# 3. เริ่มทำงานแบบกล้องวงจรปิด: บันทึกสภาพปัจจุบันเงียบๆ โดยไม่ส่งแจ้งเตือนตอนเปิดระบบ\\nif not tm[\\\"init\\\"]:\\n\\tif tm[\\\"n\\\"] >= STABLE:\\n\\t\\ttm[\\\"ok\\\"] = cur.copy()\\n\\t\\ttm[\\\"init\\\"] = True\\n\\t\\ttm[\\\"line_status\\\"] = \\\"Ready\\\"\\n\\n# 4. แจ้งเตือนเฉพาะเมื่อมีการหยิบหรือคืนอุปกรณ์\\nelif tm[\\\"n\\\"] == STABLE and cur != tm[\\\"ok\\\"]:\\n\\tb_list, r_list = [], []\\n\\tfor k in all_keys:\\n\\t\\td = cur.get(k, 0) - tm[\\\"ok\\\"].get(k, 0)\\n\\t\\tif d < 0:\\n\\t\\t\\tb_list.append(u\\\"\\\\u2022 %s (%d \\\\u0e0a\\\\u0e34\\\\u0e49\\\\u0e19)\\\" % (u(k), -d))\\n\\t\\telif d > 0:\\n\\t\\t\\tr_list.append(u\\\"\\\\u2022 %s (%d \\\\u0e0a\\\\u0e34\\\\u0e49\\\\u0e19)\\\" % (u(k), d))\\n\\n\\tif now - tm.get(\\\"known_ts\\\", 0) <= MEM_SEC:\\n\\t\\tst = \\\"known\\\"\\n\\telif tm[\\\"st\\\"] == \\\"unknown\\\" and (now - tm[\\\"ts\\\"] <= MEM_SEC):\\n\\t\\tst = \\\"unknown\\\"\\n\\telse:\\n\\t\\tst = \\\"none\\\"\\n\\n\\toff_tag = u\\\"\\\" if is_work_time else u\\\" [\\\\u0e19\\\\u0e2d\\\\u0e01\\\\u0e40\\\\u0e27\\\\u0e25\\\\u0e32\\\\u0e07\\\\u0e32\\\\u0e19]\\\"\\n\\n\\tif st == \\\"known\\\":\\n\\t\\thdr = u\\\"\\\\U0001f4e4 \\\\u0e41\\\\u0e08\\\\u0e49\\\\u0e07\\\\u0e40\\\\u0e15\\\\u0e37\\\\u0e2d\\\\u0e19\\\\u0e01\\\\u0e32\\\\u0e23\\\\u0e2b\\\\u0e22\\\\u0e34\\\\u0e1a\\\\u0e2d\\\\u0e38\\\\u0e1b\\\\u0e01\\\\u0e23\\\\u0e13\\\\u0e4c%s\\\" % off_tag\\n\\t\\twho = u\\\"%s (\\\\u0e1e\\\\u0e19\\\\u0e31\\\\u0e01\\\\u0e07\\\\u0e32\\\\u0e19)\\\" % u(tm[\\\"who\\\"])\\n\\telif st == \\\"unknown\\\":\\n\\t\\thdr = u\\\"\\\\U0001f6a8 \\\\u0e41\\\\u0e08\\\\u0e49\\\\u0e07\\\\u0e40\\\\u0e15\\\\u0e37\\\\u0e2d\\\\u0e19! \\\\u0e1a\\\\u0e38\\\\u0e04\\\\u0e04\\\\u0e25\\\\u0e44\\\\u0e21\\\\u0e48\\\\u0e21\\\\u0e35\\\\u0e02\\\\u0e49\\\\u0e2d\\\\u0e21\\\\u0e39\\\\u0e25\\\\u0e43\\\\u0e19\\\\u0e23\\\\u0e30\\\\u0e1a\\\\u0e1a\\\\u0e2b\\\\u0e22\\\\u0e34\\\\u0e1a\\\\u0e2d\\\\u0e38\\\\u0e1b\\\\u0e01\\\\u0e23\\\\u0e13\\\\u0e4c%s\\\" % off_tag\\n\\t\\twho = u\\\"\\\\u26a0\\\\ufe0f \\\\u0e1a\\\\u0e38\\\\u0e04\\\\u0e04\\\\u0e25\\\\u0e44\\\\u0e21\\\\u0e48\\\\u0e21\\\\u0e35\\\\u0e02\\\\u0e49\\\\u0e2d\\\\u0e21\\\\u0e39\\\\u0e25\\\\u0e43\\\\u0e19\\\\u0e23\\\\u0e30\\\\u0e1a\\\\u0e1a (Unknown)\\\"\\n\\telse:\\n\\t\\thdr = u\\\"\\\\U0001f6a8 \\\\u0e41\\\\u0e08\\\\u0e49\\\\u0e07\\\\u0e40\\\\u0e15\\\\u0e37\\\\u0e2d\\\\u0e19! \\\\u0e21\\\\u0e35\\\\u0e04\\\\u0e19\\\\u0e2b\\\\u0e22\\\\u0e34\\\\u0e1a\\\\u0e2d\\\\u0e38\\\\u0e1b\\\\u0e01\\\\u0e23\\\\u0e13\\\\u0e4c (\\\\u0e44\\\\u0e21\\\\u0e48\\\\u0e21\\\\u0e35\\\\u0e02\\\\u0e49\\\\u0e2d\\\\u0e21\\\\u0e39\\\\u0e25\\\\u0e43\\\\u0e19\\\\u0e23\\\\u0e30\\\\u0e1a\\\\u0e1a)%s\\\" % off_tag\\n\\t\\twho = u\\\"\\\\u26a0\\\\ufe0f \\\\u0e1a\\\\u0e38\\\\u0e04\\\\u0e04\\\\u0e25\\\\u0e44\\\\u0e21\\\\u0e48\\\\u0e21\\\\u0e35\\\\u0e02\\\\u0e49\\